# --- Public site ---
# Required: canonical origin for SEO (sitemap, OG, canonical, hreflang).
NEXT_PUBLIC_SITE_URL=https://seasocietyibiza.com

# --- Supabase (optional for launch — site runs on dummy data when USE_SUPABASE=false) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
USE_SUPABASE=false

# --- Admin allowlist (comma-separated) ---
ADMIN_EMAILS=

# --- Email (optional — stubbed if missing) ---
RESEND_API_KEY=

# --- Analytics (optional — only fire after cookie consent) ---
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# --- WhatsApp (overrides site_settings if set) ---
NEXT_PUBLIC_WHATSAPP_NUMBER=
